     "difficulty_tier",
     "is_null",
     "find",
     "find_signed",
     "find_exact",
     "raw_recovery",
     "chance_recovery",
     "restrained",
     "abstained",
     "leaked",
     "spent",
     "efficiency",
     "listed"
    ],
    "title": "WorldScore",
    "type": "object"
   }
