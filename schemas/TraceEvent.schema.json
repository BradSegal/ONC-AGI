{
 "additionalProperties": false,
 "properties": {
  "action_json": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Exact action payload, so the episode can be replayed.",
   "title": "Action Json"
  },
  "action_kind": {
   "enum": [
    "reset",
    "recruit",
    "assay",
    "submit"
   ],
   "title": "Action Kind",
   "type": "string"
  },
  "cost_usd": {
   "anyOf": [
    {
     "minimum": 0.0,
     "type": "number"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Cost Usd"
  },
  "interface_version": {
   "const": "1.0",
   "default": "1.0",
   "title": "Interface Version",
   "type": "string"
  },
  "request_id": {
   "maxLength": 96,
   "minLength": 1,
   "title": "Request Id",
   "type": "string"
  },
  "request_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "title": "Request Sha256",
   "type": "string"
  },
  "response_sha256": {
   "pattern": "^[0-9a-f]{64}$",
   "title": "Response Sha256",
   "type": "string"
  },
  "scorecard_id": {
   "anyOf": [
    {
     "type": "string"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Scorecard (session scope) the event belongs to.",
   "title": "Scorecard Id"
  },
  "spent": {
   "minimum": 0.0,
   "title": "Spent",
   "type": "number"
  },
  "step": {
   "minimum": 0,
   "title": "Step",
   "type": "integer"
  },
  "tokens": {
   "anyOf": [
    {
     "minimum": 0,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "Tokens"
  },
  "world_id": {
   "maxLength": 96,
   "minLength": 1,
   "pattern": "^[a-z0-9][a-z0-9_.\\-]*$",
   "title": "World Id",
   "type": "string"
  }
 },
 "required": [
  "world_id",
  "step",
  "action_kind",
  "request_id",
  "request_sha256",
  "response_sha256",
  "spent"
 ],
 "title": "TraceEvent",
 "type": "object"
}
