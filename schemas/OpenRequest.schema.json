{
 "$defs": {
  "Mode": {
   "enum": [
    "full_access",
    "sequential"
   ],
   "title": "Mode",
   "type": "string"
  },
  "Tier": {
   "enum": [
    "public_train",
    "public_eval",
    "private"
   ],
   "title": "Tier",
   "type": "string"
  }
 },
 "additionalProperties": false,
 "properties": {
  "agent": {
   "maxLength": 96,
   "minLength": 1,
   "title": "Agent",
   "type": "string"
  },
  "mode": {
   "anyOf": [
    {
     "$ref": "#/$defs/Mode"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Restrict the worlds to one mode."
  },
  "n_worlds": {
   "anyOf": [
    {
     "exclusiveMinimum": 0,
     "maximum": 10000,
     "type": "integer"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "title": "N Worlds"
  },
  "tags": {
   "default": [],
   "items": {
    "type": "string"
   },
   "title": "Tags",
   "type": "array"
  },
  "tier": {
   "$ref": "#/$defs/Tier"
  },
  "track": {
   "default": "open",
   "title": "Track",
   "type": "string"
  },
  "world_ids": {
   "anyOf": [
    {
     "items": {
      "type": "string"
     },
     "maxItems": 10000,
     "minItems": 1,
     "type": "array"
    },
    {
     "type": "null"
    }
   ],
   "default": null,
   "description": "Named worlds (public train only).",
   "title": "World Ids"
  }
 },
 "required": [
  "agent",
  "tier"
 ],
 "title": "OpenRequest",
 "type": "object"
}
